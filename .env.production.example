# Meridian Supply - Configuración de PRODUCCIÓN
# Copia este archivo a .env.production y rellena TODOS los valores
# NUNCA subas este archivo a git con claves reales

# ===========================================
# BASE DE DATOS (MongoDB)
# ===========================================
# En Docker Compose usa el nombre del servicio: mongodb
# (dentro del contenedor, 127.0.0.1 sería la propia app, no mongo)
DATABASE_URL=mongodb://mongodb:27017/meridian-supply

# Puerto público de la app (mapeado a 3000 dentro del contenedor).
# Usa uno distinto a 3000 si tu servidor ya tiene algo en ese puerto.
PORT=3001

# ===========================================
# PAYLOAD CMS
# ===========================================
# Genera uno seguro: openssl rand -hex 32
PAYLOAD_SECRET=REEMPLAZA_CON_CLAVE_SEGURA_32_CHARS

# URLs públicas (cambia por tu dominio en producción)
NEXT_PUBLIC_SERVER_URL=https://tudominio.com
PAYLOAD_PUBLIC_SERVER_URL=https://tudominio.com

# Para preview de drafts en admin
PREVIEW_SECRET=REEMPLAZA_CON_OTRA_CLAVE_SEGURA

# ===========================================
# STRIPE (opcional)
# ===========================================
# Déjalas VACÍAS si aún no quieres cobrar: catálogo, carrito y CMS funcionan
# igual, pero el checkout no podrá completar pedidos.
# Para activarlas: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret del webhook. Solo si ya configuraste Stripe.
# Test:  npm run stripe-webhooks  (cambia en cada ejecución)
# Prod:  dashboard > Developers > Webhooks > Add endpoint
STRIPE_WEBHOOKS_SIGNING_SECRET=

# ===========================================
# MARCA
# ===========================================
COMPANY_NAME="Meridian Supply"
SITE_NAME="Meridian Supply"

# ===========================================
# OPCIONAL: Email (para confirmaciones de pedido)
# ===========================================
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=tu-usuario
# SMTP_PASS=tu-password
# SMTP_FROM="Meridian Supply <noreply@tudominio.com>"
# ===========================================
# SEED - Credenciales del admin para seed-prod.sh
# ===========================================
# El seed aborta si faltan. Cambia la contrasena tras el primer seed.
SEED_ADMIN_EMAIL="admin@tu-dominio.com"
SEED_ADMIN_PASSWORD="CAMBIAR_ESTA_CONTRASENA"
SEED_ADMIN_NAME="Admin"
# true = solo contenido (productos, categorias, paginas, media).
# false = anade pedidos, carritos y transacciones de ejemplo. No en produccion.
SEED_CONTENT_ONLY=true
